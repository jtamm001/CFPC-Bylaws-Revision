install.packages("diffr")
setwd("R_Studio_Home/CFPC/CFPC-Bylaws-Revision/")
getwd()
# Verify your files in this folder are visible to R:
list.files()
# Run your diffr code directly:
library(diffr)
diffr(
before = "Current-Bylaws-Archived/1951-CFPC-Bylaws.md",
after = "Proposed-2026-Bylaws/Article-4-Committees.md",
beforeTitle = "1951 Legacy Bylaws",
afterTitle = "2026 Proposed Revision"
)
library(diffr)
diffr(
before = "Current-Bylaws-Archived/1951-CFPC-Bylaws.md",
after = "Proposed-2026-Bylaws/Article-4-Committees.md"
)
library(diffr)
diffr(
file1 = "Current-Bylaws-Archived/1951-CFPC-Bylaws.md",
file2 = "Proposed-2026-Bylaws/Article-4-Committees.md",
before = "1951 Legacy Bylaws",
after = "2026 Proposed Revision (Article IV)"
)
library(diffr)
diffr(
file1 = "Current-Bylaws-Archived/1951-CFPC-Bylaws.md",
file2 = "Proposed-2026-Bylaws/Proposed-2026-Bylaws.md",
before = "1951 Legacy Bylaws",
after = "2026 Proposed Revision"
)
savehistory("C:/Users/joele/Documents/R_Studio_Home/CFPC/CFPC-Bylaws-Revision/Console_Code/diffr-comparision-code.Rhistory")
